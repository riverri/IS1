<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>es.ucm.fdi.is1</groupId>
    <artifactId>apuestas</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>apuestas</name>
    <description>Web de apuestas deportivas con moneda virtual (IS1, UCM)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Web (controladores MVC) + plantillas HTML -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Base de datos: JPA + H2 en memoria para desarrollo -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <!-- Migraciones de la base de datos (src/main/resources/db/migration) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- PostgreSQL: base de datos permanente en el servidor (ver README) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Seguridad: registro, inicio de sesión y roles -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Cliente HTTP para la API de datos deportivos -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>

        <!-- Correo: enlace para recuperar la contraseña (HU-17) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Validación (@NotBlank, @DecimalMin…) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Recarga automática al cambiar código -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Pruebas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Cobertura de las pruebas: ./mvnw verify deja el informe en target/site/jacoco/index.html -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <id>preparar</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>informe</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Cobertura mínima: si un cambio la baja de aquí, ./mvnw verify falla (y la CI con él).
                         Está un poco por debajo de la actual, para que no falle por un par de líneas -->
                    <execution>
                        <id>cobertura-minima</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Análisis estático (SpotBugs): busca fallos típicos en el código compilado (nulos, comparaciones mal
                 hechas, recursos sin cerrar…). falla con los de prioridad alta. Se ejecuta en ./mvnw verify (y así en la CI); suelto, ./mvnw compile spotbugs:check -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.10.5.0</version>
                <configuration>
                    <threshold>High</threshold>
                    <effort>Max</effort>
                    <excludeFilterFile>spotbugs-excluir.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>analisis-estatico</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Pruebas de mutación (PIT): ./mvnw -Pmutacion test-compile org.pitest:pitest-maven:mutationCoverage
             PIT cambia el código a propósito (un > por un >=, un + por un -, quita una llamada…) y vuelve a pasar las
             pruebas: si siguen pasando, ese cambio "sobrevive" y hay algo que las pruebas no comprueban. Se aplica a la
             lógica que tiene pruebas unitarias rápidas (sin arrancar Spring). Informe en target/pit-reports/index.html -->
        <profile>
            <id>mutacion</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.30.2</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <!-- Para añadir la lógica de otro paquete, se pone aquí su clase y abajo su prueba unitaria -->
                            <targetClasses>
                                <param>es.ucm.fdi.is1.apuestas.cuotas.CalculadoraCuotas*</param>
                                <param>es.ucm.fdi.is1.apuestas.cuotas.Especial*</param>
                                <param>es.ucm.fdi.is1.apuestas.eventos.Evento</param>
                                <param>es.ucm.fdi.is1.apuestas.equipos.Equipo</param>
                                <param>es.ucm.fdi.is1.apuestas.equipos.Alineacion*</param>
                                <param>es.ucm.fdi.is1.apuestas.apuesta.Estadisticas</param>
                                <param>es.ucm.fdi.is1.apuestas.usuarios.Usuario</param>
                                <param>es.ucm.fdi.is1.apuestas.usuarios.NombresProhibidos*</param>
                                <param>es.ucm.fdi.is1.apuestas.web.Formato*</param>
                            </targetClasses>
                            <targetTests>
                                <param>es.ucm.fdi.is1.apuestas.cuotas.CalculadoraCuotasTest</param>
                                <param>es.ucm.fdi.is1.apuestas.cuotas.EspecialTest</param>
                                <param>es.ucm.fdi.is1.apuestas.eventos.EventoTest</param>
                                <param>es.ucm.fdi.is1.apuestas.equipos.EquipoTest</param>
                                <param>es.ucm.fdi.is1.apuestas.equipos.AlineacionTest</param>
                                <param>es.ucm.fdi.is1.apuestas.apuesta.EstadisticasTest</param>
                                <param>es.ucm.fdi.is1.apuestas.usuarios.UsuarioTest</param>
                                <param>es.ucm.fdi.is1.apuestas.usuarios.NombresProhibidosTest</param>
                                <param>es.ucm.fdi.is1.apuestas.web.FormatoTest</param>
                            </targetTests>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>CSV</outputFormat>
                            </outputFormats>
                            <timestampedReports>false</timestampedReports>
                            <mutationThreshold>80</mutationThreshold>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
