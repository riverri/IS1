# Formato común para todos los editores (IntelliJ, VS Code, Eclipse… lo leen solos): https://editorconfig.org
# Las reglas de Java que importan las comprueba además ./mvnw verify (checkstyle.xml).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.java]
max_line_length = 140

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# En Markdown, dos espacios al final de una línea son un salto de línea
trim_trailing_whitespace = false

[*.cmd]
end_of_line = crlf
